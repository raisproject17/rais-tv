<?xml version="1.0" encoding="utf-8"?>
<!-- Rais TV fork: FLIP CLOCK screensaver, menggantikan thin clock upstream.
     Full layar, center: jam flip HH:MM, logo RAIS.PROJECT DI BAWAH JAM,
     lalu hari + tanggal + tahun (Indonesia, 24 jam).
     ClockScene mengisi flipHour/flipMinute/flipDate tiap menit dan hanya
     menggeser konten beberapa dp (micro-shift) — tetap terlihat center,
     tapi tidak diam total di piksel yang sama (anti burn-in).
     Dipakai bersama oleh ClockActivity (Home idle) dan ClockDream
     (screensaver sistem). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <View
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/flipHour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/flip_card"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:text="00"
                android:textColor="#FFFFFFFF"
                android:textSize="150sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="-0.02"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text=":"
                android:textColor="#FFFFFFFF"
                android:textSize="120sp"
                android:fontFamily="@string/font_light"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/flipMinute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/flip_card"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:text="00"
                android:textColor="#FFFFFFFF"
                android:textSize="150sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="-0.02"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Logo DI BAWAH JAM (jawaban user #4). Versi putih transparan. -->
        <ImageView
            android:id="@+id/flipLogo"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:adjustViewBounds="true"
            android:src="@drawable/rais_logo_white"
            android:contentDescription="RAIS.PROJECT"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/flipDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Senin, 25 Oktober 2026"
            android:textColor="#B3FFFFFF"
            android:textSize="28sp"
            android:fontFamily="@string/font_regular"
            android:letterSpacing="0.08"
            android:textAllCaps="true" />
    </LinearLayout>
</FrameLayout>
